# ============================================================
#  Polymarket copy-trading bot — конфигурация
#  Имена переменных ДОЛЖНЫ совпадать с полями класса Settings
#  в core/config.py (регистр не важен, имя — важно).
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Кто может пользоваться ботом. Через запятую.
ALLOWED_USER_IDS=

# --- Кошельки ---
# ВНИМАНИЕ про многопользовательский режим:
# эти адреса ГЛОБАЛЬНЫЕ — bot/handlers/start.py прописывает
# MY_PROXY_WALLET_ADDRESS в proxy_wallet КАЖДОМУ пользователю.
# То есть все торгуют с ОДНОГО кошелька. Подробности внизу файла.
#
# MY_WALLET_ADDRESS       — твой обычный кошелёк (MetaMask), EOA
# MY_PROXY_WALLET_ADDRESS — адрес из polymarket.com → Settings,
#                           на нём реально лежат деньги и позиции
MY_WALLET_ADDRESS=
MY_PROXY_WALLET_ADDRESS=
PROXY_WALLET_TYPE=SAFE

ALCHEMY_WS_URL=
ONCHAIN_MODE=shadow

# --- Ключи для торговли (нужны только при SIMULATION_MODE=false) ---
MY_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- Эндпоинты (менять не нужно) ---
POLYGON_RPC_URL=https://polygon-rpc.com
CLOB_BASE_URL=https://clob.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com
DATA_API_BASE_URL=https://data-api.polymarket.com
RELAYER_BASE_URL=https://relayer-v2.polymarket.com

# --- Инфраструктура ---
# В Docker хост = ИМЯ СЕРВИСА из docker-compose.yml, НЕ localhost.
REDIS_URL=redis://redis:6379/0
# Для нескольких пользователей нужен Postgres, а не SQLite:
# SQLite при конкурентной записи даёт "database is locked".
DATABASE_URL=postgresql+asyncpg://polybot:polybot@postgres:5432/polybot

# --- Торговые параметры ---
DEFAULT_BET_AMOUNT=2.00
DEFAULT_BET_MODE=fixed
MAX_BET_AMOUNT=100.0

# Интервал опроса Data API. Лимит /trades — 200 запросов/10с.
POLL_INTERVAL_SECONDS=0.25

# Окно схлопывания транзакций ОДНОГО ордера трейдера (секунды).
COPY_DEDUP_WINDOW_SECONDS=15

# Часовой пояс для времени в уведомлениях (часы от UTC). 3 = Хельсинки.
DISPLAY_TIMEZONE_OFFSET_HOURS=3


# Торговать, если проверку региона выполнить не удалось.
# false (по умолчанию) — боевая торговля останавливается до успешной
# проверки. Ставьте true, только если регион заведомо разрешён.
GEOBLOCK_FAIL_OPEN=false
# Ограничения риска
MAX_OPEN_POSITIONS=20
MAX_TOTAL_EXPOSURE=50
MAX_TRADE_AGE_SECONDS=45

# ОБЯЗАТЕЛЬНО, если пользователи вводят свои ключи через бота.
# Без него мастер /setup откажется работать: хранить чужой приватный
# ключ незашифрованным недопустимо.
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
RECONCILIATION_SWEEP_INTERVAL_SECONDS=60.0

# true — ордера не уходят на биржу, всё остальное работает.
SIMULATION_MODE=false

# ============================================================
#  Что нужно для полноценной многопользовательской работы
# ------------------------------------------------------------
#  Кошелёк и ключи заданы глобально одним набором. Чтобы каждый
#  торговал со своего счёта, их надо перенести в таблицу users
#  (поле proxy_wallet уже есть):
#    - у каждого свой proxy_wallet
#    - у каждого свои CLOB_API_KEY / SECRET / PASSPHRASE
#    - PolymarketClient.secure() должен создавать клиента под
#      конкретного пользователя, а не одного глобального
#  Пока это не сделано, многопользовательский режим корректен
#  только при SIMULATION_MODE=true.
# ============================================================
